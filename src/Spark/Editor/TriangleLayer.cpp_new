void TriangleLayer::OnImGuiRender() {
    // Gizmo Operation Mode
    static ImGuizmo::OPERATION m_CurrentGizmoOperation(ImGuizmo::TRANSLATE);
    static bool s_GizmoActive = false;

    ImGuizmo::BeginFrame();

    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2{ 0, 0 });
    
    Entity selectedEntity = m_SceneHierarchyPanel.GetSelectedEntity();

    // Fenster-Flags: Sperren, wenn Gizmo aktiv ist oder benutzt wird
    ImGuiWindowFlags window_flags = ImGuiWindowFlags_None;
    if (s_GizmoActive)
        window_flags |= ImGuiWindowFlags_NoMove;

    ImGui::Begin("Viewport", nullptr, window_flags);
    
    // Viewport Input handling for Gizmo modes
    if (ImGui::IsWindowFocused()) {
        if (ImGui::IsKeyPressed(ImGuiKey_W)) { m_CurrentGizmoOperation = ImGuizmo::TRANSLATE; SP_TRACE("Gizmo: Translate Mode"); }
        if (ImGui::IsKeyPressed(ImGuiKey_E)) { m_CurrentGizmoOperation = ImGuizmo::ROTATE;    SP_TRACE("Gizmo: Rotate Mode"); }
        if (ImGui::IsKeyPressed(ImGuiKey_R)) { m_CurrentGizmoOperation = ImGuizmo::SCALE;     SP_TRACE("Gizmo: Scale Mode"); }
    }

    ImVec2 viewportPanelSize = ImGui::GetContentRegionAvail();
    m_ViewportSize = { viewportPanelSize.x, viewportPanelSize.y };
    
    uint32_t textureID = m_Framebuffer->GetColorAttachmentRendererID();
    ImGui::Image((void*)(intptr_t)textureID, ImVec2{ m_ViewportSize.x, m_ViewportSize.y }, ImVec2{ 0, 1 }, ImVec2{ 1, 0 });

    // Gizmos
    s_GizmoActive = false;
    if (selectedEntity && !m_ActiveScene->IsSimulating()) {
        ImGuizmo::SetOrthographic(true);
        ImGuizmo::SetDrawlist();

        // Wir nutzen die Item-Rect des Image-Widgets für maximale Präzision
        ImVec2 viewportOffset = ImGui::GetItemRectMin(); 
        ImVec2 viewportSize = ImGui::GetItemRectSize();

        ImGuizmo::SetRect(viewportOffset.x, viewportOffset.y, viewportSize.x, viewportSize.y);

        // Kamera Matrizen
        const glm::mat4& cameraProjection = m_Camera.GetProjectionMatrix();
        glm::mat4 cameraView = m_Camera.GetViewMatrix();

        // Entity Transform
        auto& tc = selectedEntity.GetComponent<TransformComponent>();
        glm::mat4 transform = tc.GetTransform();

        // Snapping
        bool snap = ImGui::IsKeyDown(ImGuiKey_LeftCtrl);
        float snapValue = 0.5f;
        if (m_CurrentGizmoOperation == ImGuizmo::ROTATE) snapValue = 45.0f;
        float snapValues[3] = { snapValue, snapValue, snapValue };

        ImGuizmo::Manipulate(glm::value_ptr(cameraView), glm::value_ptr(cameraProjection), 
            m_CurrentGizmoOperation, ImGuizmo::LOCAL, glm::value_ptr(transform),
            nullptr, snap ? snapValues : nullptr);

        s_GizmoActive = ImGuizmo::IsOver() || ImGuizmo::IsUsing();

        if (ImGuizmo::IsUsing()) {
            float matrixTranslation[3], matrixRotation[3], matrixScale[3];
            ImGuizmo::DecomposeMatrixToComponents(glm::value_ptr(transform), matrixTranslation, matrixRotation, matrixScale);
            
            // Werte zurückschreiben
            tc.Translation = { matrixTranslation[0], matrixTranslation[1], matrixTranslation[2] };
            tc.Rotation = { matrixRotation[0], matrixRotation[1], matrixRotation[2] };
            tc.Scale = { matrixScale[0], matrixScale[1], matrixScale[2] };
        }
    }

    ImGui::End();
    ImGui::PopStyleVar();

    m_SceneHierarchyPanel.OnImGuiRender();
    m_ContentBrowserPanel.OnImGuiRender(m_FileViewerPanel);
    m_FileViewerPanel.OnImGuiRender();
    m_ConsolePanel.OnImGuiRender();
    if (m_ShowPlanPanel) m_PlanPanel.OnImGuiRender(&m_ShowPlanPanel);

    ImGui::Begin("Settings");
    ImGui::Checkbox("Show Planner", &m_ShowPlanPanel);
    if (ImGui::Button("Reload Plan Data")) {
        m_PlanPanel.Load();
    }
    ImGui::Separator();
    
    // Play / Stop Buttons
    if (ImGui::Button("Play")) {
        m_ActiveScene->OnRuntimeStart();
    }
    ImGui::SameLine();
    if (ImGui::Button("Stop")) {
        m_ActiveScene->OnRuntimeStop();
    }
    
    ImGui::Separator();
    
    if (ImGui::Button("Save Scene")) {
        SceneSerializer serializer(m_ActiveScene);
        serializer.Serialize("assets/scenes/Example.scene");
    }
    if (ImGui::Button("Load Scene")) {
        m_ActiveScene->Clear();
        SceneSerializer serializer(m_ActiveScene);
        serializer.Deserialize("assets/scenes/Example.scene");
    }
    ImGui::Separator();
    if (ImGui::Button("Add Square")) {
        auto square = m_ActiveScene->CreateEntity("New Square");
        square.AddComponent<SpriteRendererComponent>(glm::vec4{1.0f, 1.0f, 1.0f, 1.0f});
    }
    ImGui::End();
}
